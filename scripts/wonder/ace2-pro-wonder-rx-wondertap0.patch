From: Action-build Wonder cloud port
Subject: [PATCH] wonder: RC bypass, wondertap0 RX, protocol 0, ANOTHER

Ace2 5.15 set_rts_threshold returns int (not void). HAS_RATE_CONTROL
plus a no-op int stub skips empty default_rc_algo.

Kiwi monitor delivers radiotap with protocol 0. Bind pdev to
wondertap0, force ETH_P_802_2 + PACKET_OTHERHOST, reset mac/network
headers, return RX_HANDLER_ANOTHER instead of nested netif_receive_skb.

No device-tree or kiwi data-path source is changed.

diff --git a/vendor/oplus/kernel/wifi/wonder/mac80211.c b/vendor/oplus/kernel/wifi/wonder/mac80211.c
--- a/vendor/oplus/kernel/wifi/wonder/mac80211.c
+++ b/vendor/oplus/kernel/wifi/wonder/mac80211.c
@@ -119,16 +119,19 @@
 	switch (wonder->data_version) {
 	case WONDER_DATA_80211:
 		ieee80211_rx_ni(wonder->hw, skb);
-		break;
+		return RX_HANDLER_CONSUMED;
 	case WONDER_DATA_80211_RADIOTAP:
-		netif_receive_skb(skb);
-		break;
+		/*
+		 * Do not nest netif_receive_skb from wondertap0's rx_handler.
+		 * RX_HANDLER_ANOTHER re-enters __netif_receive_skb_core for
+		 * skb->dev (already set to wonder0).
+		 */
+		return RX_HANDLER_ANOTHER;
 	default:
 		vdev->stats.rx_dropped++;
 		wonder_error("Dropping Not supported data_version %d.\n", wonder->data_version);
 		goto drop;
 	}
-	return RX_HANDLER_CONSUMED;
 drop:
 	/* Drop Frames */
 	if (vdev) {
@@ -152,6 +155,8 @@
 	struct sk_buff **pskb)
 {
 	struct sk_buff *skb = *pskb;
+	struct ieee80211_radiotap_header *radhdr;
+	u16 rt_len;
 
 	/*
 	 *  It's expected the mac_header and protocol values will be filled in vendor's driver.
@@ -159,12 +164,25 @@
 	 *	skb->protocol = htons(ETH_P_802_2);
 	 */
 	/* LLC */
-	if (skb->protocol == htons(ETH_P_802_2)) {
-		return wonder_rx_80211_frame(wonder, skb);
-	} else if (0 && skb->protocol == htons(ETH_P_802_3)) {
+	if (skb->protocol == htons(ETH_P_802_2))
+		goto deliver;
+	else if (0 && skb->protocol == htons(ETH_P_802_3))
 		return wonder_rx_8023_frame(wonder, skb);
-	}
-	return RX_HANDLER_PASS;
+
+	if (skb->len < sizeof(*radhdr))
+		return RX_HANDLER_PASS;
+	radhdr = (struct ieee80211_radiotap_header *)skb->data;
+	if (radhdr->it_version != 0)
+		return RX_HANDLER_PASS;
+	rt_len = le16_to_cpu(radhdr->it_len);
+	if (rt_len < sizeof(*radhdr) || rt_len > skb->len)
+		return RX_HANDLER_PASS;
+deliver:
+	skb->protocol = htons(ETH_P_802_2);
+	skb->pkt_type = PACKET_OTHERHOST;
+	skb_reset_mac_header(skb);
+	skb_reset_network_header(skb);
+	return wonder_rx_80211_frame(wonder, skb);
 }
 
 static bool wonder_80211_common_filter(struct wonder_data *wonder,
@@ -645,8 +663,18 @@
 	 * may be responsible for creating the underlying physical network device.
 	 * Therefore, we retrieve the device only after wondertap_init() has
 	 * been called.
+	 *
+	 * Ace2: prefer wondertap0 created by vendor init. service.sh historically
+	 * passes physical_name=wlan0, which has no monitor RX.
 	 */
-	ret = wonder_pdev_get(wonder, pdev_name);
+	ret = wonder_pdev_get(wonder, PDEV_NAME);
+	if (!ret) {
+		wonder_info("RX pdev bound to %s (vendor monitor)\n", PDEV_NAME);
+	} else {
+		wonder_info("wondertap0 missing, fallback physical_name=%s\n",
+			    pdev_name);
+		ret = wonder_pdev_get(wonder, pdev_name);
+	}
 	if (ret) {
 		wonder_error("Failed to get physical device %s\n", pdev_name);
 		wondertap_deinit(&wonder->wondertap_data);
@@ -957,8 +985,16 @@
 	return wonder->iftype == NL80211_IFTYPE_ADHOC;
 }
 
+static int wonder_set_rts_threshold(struct ieee80211_hw *hw, u32 value)
+{
+	(void)hw;
+	(void)value;
+	return 0;
+}
+
 static const struct ieee80211_ops wonder_mac80211_ops = {
 	.tx                 = wonder_tx,
+	.set_rts_threshold  = wonder_set_rts_threshold,
 	.start              = wonder_start,
 	.stop               = wonder_stop,
 	.config             = wonder_config,
@@ -1067,6 +1103,12 @@
 	hw->queues = 4;
 
 	/* Set Hardware Capabilities */
+	/*
+	 * Soft-MAC TX rate is decided by kiwi HDD, not minstrel. Ace2 5.15
+	 * ieee80211_ops.set_rts_threshold returns int. Dummy satisfies
+	 * rate.c WARN_ON when HAS_RATE_CONTROL is set.
+	 */
+	ieee80211_hw_set(hw, HAS_RATE_CONTROL);
 	ieee80211_hw_set(hw, SUPPORTS_PS);
 	ieee80211_hw_set(hw, SINGLE_SCAN_ON_ALL_BANDS);
 	ieee80211_hw_set(hw, SIGNAL_DBM);
